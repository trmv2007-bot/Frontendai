{
  "manifest_version": 3,
  "name": "FrontendAI OS",
  "version": "1.0.0",
  "description": "100% frontend AI assistant OS — private, local, no backend. Chat, voice, vision, code, files, P2P, CRDT, multi-agent, RAG, plugins. Lives in any page.",
  "author": "FrontendAI",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "FrontendAI OS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-48.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-48.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected/*", "icons/*", "dist/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-os": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Toggle FrontendAI OS"
    }
  }
}
